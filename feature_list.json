{
  "project": "FILL: nombre del proyecto",
  "description": "FILL: descripción breve del proyecto",
  "rules": {
    "one_feature_at_a_time": true,
    "require_tests_to_close": true,
    "require_approved_spec_to_implement": true,
    "valid_status": [
      "pending",
      "spec_ready",
      "in_progress",
      "done",
      "blocked"
    ],
    "valid_release": ["major", "minor", "patch"],
    "release_to_branch": "major→feature/<name>-major, minor→feature/<name>-minor, patch→fix/<name> (default minor si la feature no declara release)",
    "sdd_required_when": "feature has \"sdd\": true"
  },
  "features": []
}