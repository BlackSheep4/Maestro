#!/usr/bin/env bash
# maestro — CLI del harness de Claude Code (bash puro, sin dependencias de Node).
#
# Se instala en ~/.maestro/bin/maestro vía install.sh. Los ficheros del harness
# viven en ~/.maestro/templates/ y `maestro init` los copia al proyecto.
#
# Sin argumentos, muestra la ayuda.

set -u

MAESTRO_VERSION="1.0.0"
MAESTRO_HOME="${MAESTRO_HOME:-$HOME/.maestro}"
TEMPLATES="$MAESTRO_HOME/templates"
SEP="────────────────────────────────────────────────────"

# Categorías de fichero para `upgrade`:
#  MERGE     — tienen HARNESS:REQUIRED + HARNESS:FILL → REQUIRED del template
#              nuevo, FILL del proyecto preservado. (AGENTS/CLAUDE no tienen
#              bloques FILL: el merge equivale a sobreescritura limpia.)
#  OVERWRITE — puramente estructurales → se sobreescriben.
#  NEVER     — propiedad del proyecto/agente → no se tocan jamás.
MERGE_FILES="docs/architecture.md docs/conventions.md docs/specs.md docs/verification.md CHECKPOINTS.md AGENTS.md CLAUDE.md"
OVERWRITE_FILES="init.sh harness.example.json .claude/settings.json .claude/agents/leader.md .claude/agents/spec_author.md .claude/agents/implementer.md .claude/agents/reviewer.md .claude/agents/explorer.md .claude/hooks/after_edit.sh .claude/hooks/before_stop.sh"
NEVER_FILES="feature_list.json harness.json progress/current.md"

# ── Colores (se desactivan si no hay tty o si NO_COLOR está puesto) ──
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'
  CYAN=$'\033[0;36m'; GRAY=$'\033[0;90m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; CYAN=''; GRAY=''; BOLD=''; NC=''
fi

ok()   { printf '%s✅ %s%s\n' "$GREEN" "$1" "$NC"; }
err()  { printf '%s❌ %s%s\n' "$RED" "$1" "$NC" >&2; }
info() { printf '%sℹ %s%s\n'  "$CYAN" "$1" "$NC"; }
warn() { printf '%s⚠ %s%s\n'  "$YELLOW" "$1" "$NC"; }

# version_ge <a> <b> → exit 0 si a >= b (compara semver con awk).
version_ge() {
  [ -n "$1" ] || return 1
  awk -v a="$1" -v b="$2" 'BEGIN{
    na=split(a,x,"."); nb=split(b,y,".");
    for(i=1;i<=3;i++){ xi=(i<=na?x[i]+0:0); yi=(i<=nb?y[i]+0:0);
      if(xi>yi) exit 0; if(xi<yi) exit 1 }
    exit 0 }'
}

# ── Parser JSON: jq (preferido) o python3, igual que init.sh ──
JT=""
json_tool() {
  if [ -n "$JT" ]; then printf '%s' "$JT"; return; fi
  if command -v jq >/dev/null 2>&1; then JT="jq"
  elif command -v python3 >/dev/null 2>&1; then JT="python3"
  else JT="none"; fi
  printf '%s' "$JT"
}

# fl <jq_filter> <python_expr> — extrae un escalar de feature_list.json.
fl() {
  if [ "$(json_tool)" = "jq" ]; then
    jq -r "$1" feature_list.json
  else
    python3 -c "import json
d=json.load(open('feature_list.json'))
v=$2
print('' if v is None else v)"
  fi
}

# fl_lines — una línea por feature: id␟status␟name␟sdd (separador \x1f, no-tab,
# para que un campo vacío no desalinee los demás).
fl_lines() {
  if [ "$(json_tool)" = "jq" ]; then
    jq -r '.features[] | [((.id // "")|tostring),(.status // ""),(.name // ""),((.sdd // false)|tostring)] | join("\u001f")' feature_list.json
  else
    python3 -c "import json
SEP='\x1f'
for f in json.load(open('feature_list.json'))['features']:
    print(SEP.join([str(f.get('id','')), f.get('status') or '', f.get('name') or '', str(bool(f.get('sdd'))).lower()]))"
  fi
}

# fl_counts — 'total done in_progress pending blocked spec_ready' (números).
fl_counts() {
  if [ "$(json_tool)" = "jq" ]; then
    jq -r '.features as $f | [($f|length),
      ([$f[]|select(.status=="done")]|length),
      ([$f[]|select(.status=="in_progress")]|length),
      ([$f[]|select(.status=="pending")]|length),
      ([$f[]|select(.status=="blocked")]|length),
      ([$f[]|select(.status=="spec_ready")]|length)] | join(" ")' feature_list.json
  else
    python3 -c "import json
f=json.load(open('feature_list.json'))['features']
c=lambda s:sum(1 for x in f if x.get('status')==s)
print(len(f),c('done'),c('in_progress'),c('pending'),c('blocked'),c('spec_ready'))"
  fi
}

# ── Detección greenfield/brownfield ──
detect_mode() {
  local found
  found=$(find . -mindepth 1 \
    \( -type d \( -name '.*' -o -name node_modules \) -prune \) -o \
    \( -type f \( -name '*.py' -o -name '*.js' -o -name '*.ts' -o -name '*.go' \
       -o -name '*.rs' -o -name '*.java' -o -name '*.rb' -o -name '*.php' \) -print \) \
    2>/dev/null | head -n1)
  [ -n "$found" ] && echo "brownfield" || echo "greenfield"
}

usage() {
  cat <<EOF
${BOLD}maestro${NC} — harness de Claude Code para desarrollo autónomo y SDD (v$MAESTRO_VERSION)

Uso: ${BOLD}maestro${NC} <comando>

Comandos:
  ${GREEN}init${NC}       Instala el harness en el directorio actual
  ${GREEN}status${NC}     Muestra el estado de las features del proyecto
  ${GREEN}check${NC}      Ejecuta ./init.sh y propaga su exit code (apto para CI)
  ${GREEN}upgrade${NC}    Actualiza el harness preservando tu contenido (HARNESS:FILL)
  ${GREEN}version${NC}    Muestra la versión de maestro
  ${GREEN}help${NC}       Muestra esta ayuda

Sin argumentos, maestro muestra esta ayuda.

Más info: https://github.com/BlackSheep4/Maestro
EOF
}

# ── Comando: init ──
cmd_init() {
  if [ -f AGENTS.md ]; then
    err 'Maestro ya está instalado en este directorio. Usa "maestro upgrade" para actualizar.'
    exit 1
  fi
  if [ ! -d "$TEMPLATES" ]; then
    err "No encuentro los templates en $TEMPLATES. ¿Instalaste maestro con el script oficial (install.sh)?"
    exit 1
  fi

  local mode; mode=$(detect_mode)
  if [ "$mode" = "brownfield" ]; then
    info 'Proyecto existente detectado (brownfield). El harness se instalará sin sobreescribir tu código.'
  else
    info 'Proyecto nuevo detectado (greenfield). El harness se instalará completo.'
  fi

  local copied=() rel
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if [ -e "$rel" ]; then continue; fi          # nunca pisa nada existente
    mkdir -p "$(dirname "$rel")"
    cp "$TEMPLATES/$rel" "$rel"
    copied+=("$rel")
  done < <(cd "$TEMPLATES" && find . -type f | sed 's|^\./||' | sort)

  # ── Flujo PR→CI→release (generado, no copiado de templates) ──
  # Define el ciclo de contribución del PROYECTO (ramas tipadas → PR → gate
  # ./init.sh → release automático), distinto del CI propio de Maestro. Se
  # generan aquí en vez de copiarse para no colisionar con el .github de Maestro.
  # No se sobreescriben si el proyecto ya los tiene.
  mkdir -p .github/workflows docs

  if [ ! -e .github/workflows/ci.yml ]; then
    cat > .github/workflows/ci.yml <<'CI_YML_EOF'
name: CI

# Espejo en CI del gate local del harness (./init.sh) + lint del nombre de rama.
# Stack-agnóstico: ./init.sh lee harness.json y ejecuta los tests del proyecto.

on:
  pull_request:
    branches: [main]

jobs:
  branch-name:
    runs-on: ubuntu-latest
    steps:
      - name: Validar el nombre de la rama
        run: |
          BRANCH="${{ github.head_ref }}"
          if echo "$BRANCH" | grep -qE '^(feature/.+-(major|minor)|fix/.+)$'; then
            echo "✅ Nombre de rama válido: $BRANCH"
          else
            echo "❌ Nombre de rama inválido: $BRANCH"
            echo "Usa una de estas convenciones:"
            echo "  feature/<nombre>-major   → release X.0.0"
            echo "  feature/<nombre>-minor   → release 0.X.0"
            echo "  fix/<nombre>             → release 0.0.X"
            exit 1
          fi

  harness-gate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup del stack (harness.json → ci.setup)
        run: |
          if [ -f harness.json ] && command -v jq >/dev/null 2>&1; then
            SETUP=$(jq -r '.ci.setup // ""' harness.json 2>/dev/null || true)
            if [ -n "$SETUP" ] && [ "$SETUP" != "null" ]; then
              echo "▶ ci.setup: $SETUP"
              bash -c "$SETUP"
            else
              echo "ℹ Sin ci.setup; uso los runtimes preinstalados del runner."
            fi
          fi

      - name: Gate del harness (./init.sh)
        run: |
          if [ ! -f harness.json ]; then
            echo "⚠ harness.json ausente: el harness aún no está configurado. Se omite el gate."
            exit 0
          fi
          chmod +x init.sh
          ./init.sh
CI_YML_EOF
    copied+=(".github/workflows/ci.yml")
  fi

  if [ ! -e .github/workflows/release.yml ]; then
    cat > .github/workflows/release.yml <<'RELEASE_YML_EOF'
name: Release

# Se dispara al MERGEAR una PR a main. Calcula el bump desde el nombre de rama
# (regla dura), crea el tag y publica el GitHub Release con las notas del PR.
# 1 PR = 1 release. La fuente de verdad de la versión son los tags git.

on:
  pull_request:
    types: [closed]
    branches: [main]

permissions:
  contents: write

jobs:
  release:
    if: github.event.pull_request.merged == true
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          # La rama base (main) ya incluye el merge: el tag debe caer en su tip,
          # no en el merge-ref del PR que checkout saca por defecto.
          ref: ${{ github.event.pull_request.base.ref }}
          fetch-depth: 0

      - name: Calcular versión siguiente desde el nombre de rama
        id: compute
        run: |
          BRANCH="${{ github.event.pull_request.head.ref }}"
          case "$BRANCH" in
            feature/*-major) LEVEL=major ;;
            feature/*-minor) LEVEL=minor ;;
            fix/*)           LEVEL=patch ;;
            *)
              echo "ℹ Rama '$BRANCH' no dispara release. Se omite."
              echo "skip=true" >> "$GITHUB_OUTPUT"
              exit 0 ;;
          esac
          LATEST=$(git tag --list 'v*.*.*' --sort=-v:refname | head -n1)
          [ -z "$LATEST" ] && LATEST="v0.0.0"
          CUR="${LATEST#v}"
          MAJOR="${CUR%%.*}"; REST="${CUR#*.}"; MINOR="${REST%%.*}"; PATCH="${REST##*.}"
          case "$LEVEL" in
            major) MAJOR=$((MAJOR+1)); MINOR=0; PATCH=0 ;;
            minor) MINOR=$((MINOR+1)); PATCH=0 ;;
            patch) PATCH=$((PATCH+1)) ;;
          esac
          NEW="v${MAJOR}.${MINOR}.${PATCH}"
          echo "skip=false" >> "$GITHUB_OUTPUT"
          echo "next=$NEW" >> "$GITHUB_OUTPUT"
          echo "▶ $BRANCH ($LEVEL): $LATEST → $NEW"

      - name: Crear y empujar el tag
        if: steps.compute.outputs.skip == 'false'
        run: |
          NEW="${{ steps.compute.outputs.next }}"
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git tag "$NEW"
          git push origin "$NEW"

      - name: Publicar GitHub Release
        if: steps.compute.outputs.skip == 'false'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.compute.outputs.next }}
          name: ${{ steps.compute.outputs.next }}
          body: |
            ${{ github.event.pull_request.title }}

            ${{ github.event.pull_request.body }}
          draft: false
          prerelease: false
RELEASE_YML_EOF
    copied+=(".github/workflows/release.yml")
  fi

  if [ ! -e .github/PULL_REQUEST_TEMPLATE.md ]; then
    cat > .github/PULL_REQUEST_TEMPLATE.md <<'PR_TPL_EOF'
## Qué hace este PR

<!-- Descripción breve. El TÍTULO y este cuerpo se usan como notas del release. -->

## Tipo de cambio

El nivel de versión se deduce del **nombre de la rama**, no de aquí:

- `feature/<x>-major` → release mayor (rompe compatibilidad)
- `feature/<x>-minor` → release minor (funcionalidad nueva compatible)
- `fix/<x>` → release patch (corrección)

## Checklist

- [ ] El nombre de la rama sigue la convención (`feature/<x>-major|minor` o `fix/<x>`).
- [ ] El gate del harness pasa en local (`./init.sh` en verde).
- [ ] El título y la descripción de esta PR sirven como notas de release.
PR_TPL_EOF
    copied+=(".github/PULL_REQUEST_TEMPLATE.md")
  fi

  if [ ! -e docs/branching.md ]; then
    cat > docs/branching.md <<'BRANCHING_EOF'
# Convención de ramas y releases

Este proyecto usa un flujo **PR → CI → release automático**. El nivel de versión
NO se decide a mano: se deduce del **nombre de la rama**.

## Tipos de rama

| Rama | Para qué | Efecto en el release |
|------|----------|----------------------|
| `feature/<nombre>-major` | Cambio que rompe compatibilidad | `X`.0.0 (mayor +1, resetea minor y patch) |
| `feature/<nombre>-minor` | Funcionalidad nueva compatible | 0.`X`.0 (minor +1, resetea patch) |
| `fix/<nombre>` | Corrección | 0.0.`X` (patch +1) |

Ejemplos: `v1.4.2` + `feature/login-major` → `v2.0.0`;
`v1.4.2` + `feature/login-minor` → `v1.5.0`;
`v1.4.2` + `fix/typo` → `v1.4.3`.

Puede haber tantas ramas `feature/*` y `fix/*` simultáneas como necesites.

## Ciclo

1. Crea tu rama con la convención de arriba.
2. Abre una PR hacia `main`.
3. El CI (`.github/workflows/ci.yml`) valida el nombre de rama y ejecuta el
   gate del harness (`./init.sh`) — el mismo que corres en local.
4. Al **mergear** la PR a `main`, `.github/workflows/release.yml` calcula la
   versión siguiente, crea el tag `vX.Y.Z` y publica el GitHub Release con el
   título y cuerpo de la PR como notas. **1 PR = 1 release.**

## Setup del CI por stack

El workflow corre `./init.sh`, que ejecuta los tests del proyecto según
`harness.json`. Si tu stack necesita un paso de preparación antes de los tests
(instalar dependencias, compilar), declara un comando opcional en `harness.json`:

```json
{
  "stack": { "language": "node", "test_cmd": "npm test", "...": "..." },
  "ci": { "setup": "npm ci" }
}
```

El workflow lo ejecuta antes de `./init.sh`. Si lo omites, usa los runtimes
preinstalados del runner (`ubuntu-latest` trae Python, Node y Go).

## Primer release

Si no hay ningún tag aún, el primer release parte de `v0.0.0`: una rama `fix/*`
produce `v0.0.1`, una `feature/*-minor` produce `v0.1.0`, una `feature/*-major`
produce `v1.0.0`.
BRANCHING_EOF
    copied+=("docs/branching.md")
  fi

  local f
  for f in init.sh .claude/hooks/after_edit.sh .claude/hooks/before_stop.sh; do
    [ -f "$f" ] && chmod +x "$f"
  done

  printf '%s\n' "$MAESTRO_VERSION" > .maestro-version
  copied+=(".maestro-version")

  echo
  ok "Maestro v$MAESTRO_VERSION instalado correctamente."
  echo
  echo "Modo: $mode"
  echo
  echo "Ficheros creados:"
  for f in "${copied[@]}"; do printf '%s  %s%s\n' "$GRAY" "$f" "$NC"; done
  echo
  echo "Siguiente paso:"
  echo "  Abre Claude Code en este directorio: claude"
  echo "  El agente completará la configuración del stack (harness.json)"
  echo "  y el onboarding del proyecto automáticamente."
}

# ── Comando: status ──
cmd_status() {
  if [ ! -f feature_list.json ]; then
    err 'No se encontró feature_list.json. ¿Está Maestro instalado? Ejecuta "maestro init".'
    exit 1
  fi
  if [ "$(json_tool)" = "none" ]; then
    err 'Necesito jq o python3 para leer feature_list.json.'
    exit 1
  fi

  local count
  count=$(fl '.features | length' "len(d['features'])" 2>/dev/null)
  if ! printf '%s' "$count" | grep -qE '^[0-9]+$'; then
    err 'feature_list.json no es válido.'
    exit 1
  fi
  if [ "$count" -eq 0 ]; then
    info 'No hay features definidas todavía. Abre Claude Code para iniciar el onboarding.'
    return
  fi

  local project
  project=$(fl '.project // "(sin nombre)"' "d.get('project') or '(sin nombre)'" 2>/dev/null)

  printf '%sProyecto: %s%s\n' "$BOLD" "$project" "$NC"
  echo "$SEP"
  printf ' %-3s %-16s %-4s %s\n' '#' 'Status' 'SDD' 'Nombre'
  echo "$SEP"

  local id status name sdd icon color sddmark cell
  while IFS=$(printf '\037') read -r id status name sdd; do
    [ -n "$id$status$name" ] || continue
    case "$status" in
      done)        icon='✅'; color="$GREEN" ;;
      in_progress) icon='🟡'; color="$YELLOW" ;;
      pending)     icon='⬜'; color="$GRAY" ;;
      blocked)     icon='🔴'; color="$RED" ;;
      spec_ready)  icon='🔵'; color="$CYAN" ;;
      *)           icon='  '; color="$NC" ;;
    esac
    sddmark='—'; [ "$sdd" = "true" ] && sddmark='●'
    cell=$(printf '%s %s' "$icon" "$status")
    printf ' %-3s %s%-16s%s %-4s %s\n' "$id" "$color" "$cell" "$NC" "$sddmark" "$name"
  done < <(fl_lines)

  echo "$SEP"

  local nums; nums=$(fl_counts)
  set -- $nums
  local total="$1" d="$2" ip="$3" pe="$4" bl="$5" sr="$6"
  local footer="Total: $total features"
  [ "$d"  -gt 0 ] 2>/dev/null && footer="$footer | $d done"
  [ "$ip" -gt 0 ] 2>/dev/null && footer="$footer | $ip in_progress"
  [ "$pe" -gt 0 ] 2>/dev/null && footer="$footer | $pe pending"
  [ "$bl" -gt 0 ] 2>/dev/null && footer="$footer | $bl blocked"
  [ "$sr" -gt 0 ] 2>/dev/null && footer="$footer | $sr spec_ready"
  echo "$footer"

  local ipname
  ipname=$(fl '[.features[]|select(.status=="in_progress")][0].name // ""' \
    "next((x['name'] for x in d['features'] if x.get('status')=='in_progress'), '')" 2>/dev/null)
  if [ -n "$ipname" ]; then
    echo
    echo "En curso: $ipname"
    [ -d "specs/$ipname" ] && echo "Spec: specs/$ipname/"
    [ -f "progress/impl_$ipname.md" ] && echo "Progreso: progress/impl_$ipname.md"
  fi
}

# ── Comando: check ──
cmd_check() {
  if [ ! -f init.sh ]; then
    err 'No se encontró init.sh. ¿Está Maestro instalado?'
    exit 1
  fi
  if [ ! -x init.sh ]; then
    warn 'init.sh no tenía permisos de ejecución. Corregido automáticamente.'
    chmod +x init.sh
  fi
  local code
  if ./init.sh; then code=0; else code=$?; fi   # streaming directo + exit code
  echo
  if [ "$code" -eq 0 ]; then
    ok 'Harness listo. Todos los checks pasaron.'
  else
    err 'El harness tiene errores. Revisa la salida anterior.'
  fi
  exit "$code"
}

# ── Merge de HARNESS:FILL (para upgrade) ──
# Preserva la REGIÓN COMPLETA `<!-- HARNESS:FILL … <!-- /HARNESS:FILL -->` del
# proyecto y reinyecta cada una en su posición dentro del template nuevo. Lo que
# queda FUERA de las regiones FILL (las secciones HARNESS:REQUIRED) lo aporta el
# template. Robusto a regiones multilínea y a varios bloques por fichero.
#   merge_fill <template> <project>  → escribe el resultado a stdout
merge_fill() {
  awk '
  FNR==NR {
    if (!pin && index($0,"<!-- HARNESS:FILL")) { pin=1; pidx++; pblk[pidx]=$0
      if (index($0,"<!-- /HARNESS:FILL -->")) pin=0
      next }
    if (pin) { pblk[pidx]=pblk[pidx] ORS $0
      if (index($0,"<!-- /HARNESS:FILL -->")) pin=0
      next }
    next
  }
  {
    if (!tin && index($0,"<!-- HARNESS:FILL")) { tin=1; tidx++; treg=$0
      if (index($0,"<!-- /HARNESS:FILL -->")) { print (tidx in pblk ? pblk[tidx] : treg); tin=0 }
      next }
    if (tin) { treg=treg ORS $0
      if (index($0,"<!-- /HARNESS:FILL -->")) { print (tidx in pblk ? pblk[tidx] : treg); tin=0 }
      next }
    print
  }
  ' "$2" "$1"
}

# ── Comando: upgrade ──
cmd_upgrade() {
  if [ ! -f .maestro-version ]; then
    err 'No se encontró .maestro-version. Este proyecto puede haber instalado Maestro manualmente. Ejecuta "maestro init" en un directorio vacío para una instalación limpia.'
    exit 1
  fi
  if [ ! -d "$TEMPLATES" ]; then
    err "No encuentro los templates en $TEMPLATES. Reinstala maestro con install.sh."
    exit 1
  fi

  local installed current
  installed=$(tr -d '[:space:]' < .maestro-version)
  current="$MAESTRO_VERSION"

  if [ "$installed" = "$current" ]; then
    ok "Ya tienes la versión más reciente de Maestro (v$current). No hay nada que actualizar."
    return
  fi
  if ! version_ge "$current" "$installed"; then
    warn "Tu proyecto está en v$installed y el maestro instalado es v$current (más antiguo)."
    warn "Reinstala maestro (install.sh) para obtener una versión >= la tuya. No se ha tocado nada."
    return
  fi

  local merged=() overwritten=() untouched=() warnings=()
  local rel tpl tmp pc tc f w

  # Merge inteligente (REQUIRED actualizado, FILL preservado).
  for rel in $MERGE_FILES; do
    tpl="$TEMPLATES/$rel"
    [ -f "$tpl" ] || continue
    if [ -f "$rel" ]; then
      pc=$(grep -cF '<!-- HARNESS:FILL' "$rel" 2>/dev/null || true)
      tc=$(grep -cF '<!-- HARNESS:FILL' "$tpl" 2>/dev/null || true)
      tmp=$(mktemp)
      merge_fill "$tpl" "$rel" > "$tmp"
      mv "$tmp" "$rel"
      if [ "${pc:-0}" -gt 0 ] 2>/dev/null; then
        merged+=("$rel — HARNESS:REQUIRED actualizado, FILL preservado")
      else
        merged+=("$rel — actualizado (sin bloques FILL)")
      fi
      if [ "${pc:-0}" != "${tc:-0}" ]; then
        warnings+=("$rel: nº de bloques HARNESS:FILL difiere (proyecto $pc, template $tc); revisa el fichero.")
      fi
    else
      mkdir -p "$(dirname "$rel")"; cp "$tpl" "$rel"; overwritten+=("$rel")
    fi
  done

  # Sobreescritura de ficheros estructurales.
  for rel in $OVERWRITE_FILES; do
    tpl="$TEMPLATES/$rel"
    [ -f "$tpl" ] || continue
    mkdir -p "$(dirname "$rel")"
    cp "$tpl" "$rel"
    case " init.sh .claude/hooks/after_edit.sh .claude/hooks/before_stop.sh " in
      *" $rel "*) chmod +x "$rel" ;;
    esac
    overwritten+=("$rel")
  done

  # Intocables.
  for rel in $NEVER_FILES; do [ -e "$rel" ] && untouched+=("$rel"); done

  printf '%s\n' "$current" > .maestro-version

  echo
  ok "Maestro actualizado: v$installed → v$current"
  if [ "${#merged[@]}" -gt 0 ]; then
    echo; echo "Ficheros actualizados (merge):"
    for f in "${merged[@]}"; do printf '%s  %s%s\n' "$GRAY" "$f" "$NC"; done
  fi
  if [ "${#overwritten[@]}" -gt 0 ]; then
    echo; echo "Ficheros sobreescritos:"
    for f in "${overwritten[@]}"; do printf '%s  %s%s\n' "$GRAY" "$f" "$NC"; done
  fi
  if [ "${#untouched[@]}" -gt 0 ]; then
    echo; echo "Ficheros sin cambios (nunca se tocan):"
    for f in "${untouched[@]}"; do printf '%s  %s%s\n' "$GRAY" "$f" "$NC"; done
  fi
  if [ "${#warnings[@]}" -gt 0 ]; then
    echo; for w in "${warnings[@]}"; do warn "$w"; done
  fi
}

# ── Dispatch ──
cmd="${1:-help}"
case "$cmd" in
  init)               shift; cmd_init "$@" ;;
  status)             shift; cmd_status "$@" ;;
  check)              shift; cmd_check "$@" ;;
  upgrade)            shift; cmd_upgrade "$@" ;;
  version|-v|--version) echo "maestro v$MAESTRO_VERSION" ;;
  help|-h|--help)     usage ;;
  *)                  err "Comando desconocido: $cmd"; echo; usage; exit 1 ;;
esac
